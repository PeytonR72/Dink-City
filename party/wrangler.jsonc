{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dink-city-party",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "durable_objects": {
    "bindings": [
      { "name": "COURT", "class_name": "Court" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Court", "Lobby"] }]
}
